# Supabase credentials (get from https://app.supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional - base URL used for QR code links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: Basecamp 3 integration (server-side only) ---
# Fill these in to enable src/lib/basecamp.ts. Never commit real values.
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REDIRECT_URI=https://localhost/callback
BASECAMP_ACCESS_TOKEN=
BASECAMP_REFRESH_TOKEN=
BASECAMP_ACCOUNT_ID=
BASECAMP_USER_AGENT=Your App Name (you@example.com)
